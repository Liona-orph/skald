# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt uses tabs and takes no options. Anything else here would be a lie the
# editor tells you until you next save.
[*.go]
indent_style = tab
indent_size = 4

[*.{md,markdown}]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
max_line_length = 80

[Makefile]
indent_style = tab

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[{Dockerfile,Dockerfile.*,*.sh}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = tab
